# ===================================================
# SmartBus Frontend Environment Variables
# ===================================================

# 1. Google Maps API Key (Optional)
# If you want to use Google Maps, insert your Google Cloud Maps JavaScript API key here:
VITE_GOOGLE_MAPS_API_KEY=

# 2. Map Provider
# Set to 'google' if you have a Google Maps API Key with Maps JavaScript API enabled.
# Set to 'osm' (default) to use free OpenStreetMap without needing any API key or billing.
VITE_MAP_PROVIDER=osm

# 3. Backend API URL (Optional, defaults to proxying to http://localhost:5001)
# VITE_API_URL=http://localhost:5001
